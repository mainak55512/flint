        "static"
    ],
    "shared_lib": [
        "shared"
    ],
    "dependencies": {
        "arena": {
            "version": "v0.1.1",
            "remote": "https://github.com/mainak55512/arena"
        },
        "CString": {
            "version": "v0.1.1",
            "remote": "https://github.com/mainak55512/CString"
        },
        "container": {
            "version": "v0.1.1",
            "remote": "https://github.com/mainak55512/container"
        },
        "yyjson": {
            "version": "0.12.0",
